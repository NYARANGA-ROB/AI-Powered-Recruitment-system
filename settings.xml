<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!-- Local repository path -->
    <localRepository>${user.home}/.m2/repository</localRepository>

    <!-- Mirror configuration: Spring AI related dependencies do not go through the Aliyun mirror -->
    <mirrors>
        <!-- Aliyun mirror (excluding Spring AI) -->
        <mirror>
            <id>aliyunmaven</id>
            <name>Aliyun public repository</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <mirrorOf>*,!spring-milestones,!spring-releases</mirrorOf>
        </mirror>

        <!-- Spring Milestone mirror (direct access) -->
        <mirror>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <mirrorOf>spring-milestones</mirrorOf>
        </mirror>
    </mirrors>

    <!-- profiles -->
    <profiles>
        <profile>
            <id>spring-ai</id>
            <repositories>
                <repository>
                    <id>spring-milestones</id>
                    <name>Spring Milestones</name>
                    <url>https://repo.spring.io/milestone</url>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <!-- Active profile -->
    <activeProfiles>
        <activeProfile>spring-ai</activeProfile>
    </activeProfiles>
</settings>
