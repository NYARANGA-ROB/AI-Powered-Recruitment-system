# ==================== SmartATS local development environment variables ====================
#
# Usage instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in the actual configuration values
# 3. The .env file is already listed in .gitignore, so it will not be committed to git
# 4. Before starting the application, make sure your IDE reads the .env file
#    - IntelliJ IDEA: install the "EnvFile" plugin
#    - Or add the environment variables to the run configuration
# ========================================================================

# ==================== Mail configuration ====================
# QQ Mail example: https://service.mail.qq.com/detail/0/75
# After enabling the SMTP service, put the authorisation code in MAIL_PASSWORD
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your_email@foxmail.com
MAIL_PASSWORD=your_smtp_auth_code

# ==================== Database configuration ====================
DB_HOST=localhost
DB_PORT=3307
DB_NAME=smartats
DB_USERNAME=smartats
DB_PASSWORD=your_db_password_here

# ==================== Redis configuration ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ==================== RabbitMQ configuration ====================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=your_rabbitmq_password_here
RABBITMQ_VHOST=smartats

# ==================== JWT configuration ====================
# ⚠️ Production must use a strong secret (at least 256 bits)
# Generate one with: openssl rand -base64 32
JWT_SECRET=SmartATS2026SecretKeyMustBeLongEnoughForHS256

# ==================== MinIO configuration ====================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_minio_secret_here

# ==================== Zhipu AI configuration ====================
# Zhipu AI open platform: https://open.bigmodel.cn/
# To get an API key: register, complete identity verification, then create one on the "API Key" page
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-4-flash-250414

# Embedding model configuration
ZHIPU_EMBEDDING_MODEL=embedding-3

# ==================== CORS configuration ====================
# Development allows all origins by default; production needs the specific front-end origins
# Separate multiple origins with commas
CORS_ALLOWED_ORIGINS=*

# ==================== Milvus vector database configuration ====================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE=default

# Model notes (latest as of February 2026):
# - glm-4-flash-250414: free language model (recommended for development and testing)
# - glm-4-flashx-250414: enhanced Flash edition (real-time retrieval, long context)
# - glm-4-air-250414: base language model (tool calling, code agents)
# - glm-4-airx: high-speed edition (fast responses)
# - glm-4-plus: high-intelligence model (recommended for production)
# - glm-4.7: latest flagship model (built for agentic coding)
# Full documentation: https://docs.bigmodel.cn/cn/guide/models/text/glm-4
