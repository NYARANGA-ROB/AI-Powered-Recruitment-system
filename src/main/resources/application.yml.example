# ==================== SmartATS application configuration template ====================
#
# 📌 Usage instructions:
# 1. Copy this file to application.yml and fill in the real configuration values
# 2. Or set environment variables (recommended for production)
#    - Development: use a .env file (do not commit it to git)
#    - Production: use environment variables or a configuration centre
# ================================================================

server:
  port: 8080                    # Application port (access http://localhost:8080 from the browser)
  servlet:
    context-path: /api/v1         # Global path prefix (every endpoint starts with /api/v1)
    multipart:
      enabled: true
      max-file-size: 10MB       # Maximum size of a single file: 10MB
      max-request-size: 50MB    # Maximum size of a request: 50MB
      file-size-threshold: 2MB  # Only written to disk once the file exceeds 2MB

spring:
  # ==================== Mail configuration ====================
  mail:
    host: ${MAIL_HOST:smtp.qq.com}
    port: ${MAIL_PORT:587}
    username: ${MAIL_USERNAME:your_email@qq.com}
    password: ${MAIL_PASSWORD}   # Read from an environment variable; locally, configure it in .env
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true
            required: true
        ssl:
          trust: ${MAIL_HOST:smtp.qq.com}
    default-encoding: UTF-8

  application:
    name: smartats              # Application name (shown in logs and monitoring)

  # ==================== Database configuration ====================
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver    # MySQL driver class
    url: jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3307}/${DB_NAME:smartats}?useSSL=false&serverTimezone=Asia/Shanghai
    username: ${DB_USERNAME:smartats}                     # Database username
    password: ${DB_PASSWORD}                          # Database password (read from an environment variable)

    # 📌 HikariCP connection pool settings (the Spring Boot default pool)
    hikari:
      maximum-pool-size: 20       # Maximum number of connections (adjust to database performance)
      minimum-idle: 5             # Minimum number of idle connections
      connection-timeout: 30000   # Timeout when obtaining a connection (milliseconds)
      idle-timeout: 600000       # Idle connection timeout (10 minutes)

  # ==================== Redis configuration ====================
  data:
    redis:
      host: ${REDIS_HOST:localhost}            # Redis server address
      port: ${REDIS_PORT:6379}                # Redis port
      password: ${REDIS_PASSWORD}                # Redis password (read from an environment variable)
      database: 0               # Redis database index (0-15, 16 databases in total)
      timeout: 5000             # Connection timeout (milliseconds)

      # 📌 Lettuce connection pool settings (the Spring Boot default Redis client)
      lettuce:
        pool:
          max-active: 20         # Maximum number of active connections
          max-idle: 10          # Maximum number of idle connections
          min-idle: 5           # Minimum number of idle connections

  # ==================== RabbitMQ configuration ====================
  rabbitmq:
    host: ${RABBITMQ_HOST:localhost}             # RabbitMQ server address
    port: ${RABBITMQ_PORT:5672}                 # AMQP protocol port (the management UI uses 15672)
    username: ${RABBITMQ_USERNAME:admin}            # Username
    password: ${RABBITMQ_PASSWORD}                # Password (read from an environment variable)
    virtual-host: ${RABBITMQ_VHOST:smartats}    # Virtual host (analogous to a MySQL database)
    listener:
      simple:
        acknowledge-mode: manual  # Acknowledge messages manually (prevents message loss)
        prefetch: 1             # Fetch only 1 message from the queue at a time (preserves ordering)

  # ==================== Jackson configuration (JSON serialization)====================
  jackson:
    date-format: yyyy-MM-dd HH:mm:ss   # Date format
    time-zone: Asia/Shanghai            # Time zone
    default-property-inclusion: non_null # Do not serialize null values (reduces JSON size)

# ==================== MyBatis-Plus configuration ====================
mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true    # Database snake_case → Java camelCase (user_name → userName)
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl  # Print SQL logs (development)
  global-config:
    db-config:
      id-type: auto                    # Auto-increment primary key (auto for MySQL, assign_id for PostgreSQL)
      logic-delete-field: deleted        # Logical delete field (soft delete)
      logic-delete-value: 1             # Value once deleted
      logic-not-delete-value: 0         # Value when not deleted

# ==================== Logging configuration ====================
logging:
  level:
    root: INFO                       # Global log level
    com.smartats: DEBUG              # Log level for this project (DEBUG during development)
    com.smartats.mapper: DEBUG       # Mapper interface logs (prints SQL)
  pattern:
    console: '%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n'  # Log format

# ==================== Application-specific configuration ====================
smartats:
  jwt:
    secret: ${JWT_SECRET:SmartATS2026SecretKeyMustBeLongEnoughForHS256}    # JWT secret (must be changed in production!)
    expiration: 7200              # Access Token expiry (2 hours, in seconds)
    refresh-expiration: 604800    # Refresh Token expiry (7 days)

  file:
    upload-path: ./data/uploads    # File upload path (where resumes are stored)
    max-size: 10485760           # Maximum file size (10MB = 10 * 1024 * 1024)

  ai:
    daily-quota: 100              # Daily AI call quota

  verification-code:
    expire-time: 300              # Verification code expiry (5 minutes = 300 seconds)

minio:
  endpoint: ${MINIO_ENDPOINT:http://localhost:9000}
  access-key: ${MINIO_ACCESS_KEY:admin}
  secret-key: ${MINIO_SECRET_KEY:admin123456}
  bucket-name: smartats-resumes
  connect-timeout: 10000  # 10 seconds
  write-timeout: 60000     # 60 seconds
  read-timeout: 10000      # 10 seconds
